# Образец окружения. Скопировать в `.env` и подставить свои значения:
#
#   cp .env.example .env
#
# `.env` в .gitignore — настоящие пароли в репозиторий не попадают.

# Подключение к БД одной строкой (dj-database-url).
# Postgres 14+; SQLite больше не используется — см. docs/17 §17.2.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DBNAME


# ── Разработке больше ничего не нужно ────────────────────────────────────
#
# Всё ниже — прод. Дефолт настроек это разработка, и переменные для неё
# заводить не надо: `DEBUG=1`, ключ подставляется небезопасный, хосты —
# localhost.


# ── Прод: один переключатель и три обязательные переменные ───────────────
#
# `DJANGO_ENV=production` включает https-редирект, HSTS, secure-куки,
# CSRF_TRUSTED_ORIGINS и раздачу статики через whitenoise. Он же делает
# три переменные ниже обязательными: без любой из них запуск падает с
# объяснением, а не работает наполовину.
#
# DJANGO_ENV=production

# Ключ подписи сессий и CSRF. Длинный, случайный, свой у каждого стенда.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY=

# Через запятую, без пробелов. Из него же собирается CSRF_TRUSTED_ORIGINS.
# DJANGO_ALLOWED_HOSTS=balaproza.kz,www.balaproza.kz

# Перед первым запуском в проде:  manage.py collectstatic --noinput


# ── Мелочи разработки ────────────────────────────────────────────────────
#
# Выключить django-debug-toolbar, не трогая DEBUG (мешает при снятии
# скриншотов и замере времени ответа).
# DEBUG_TOOLBAR=0
